SELECT 
    VENDA_SABOR.SABOR, 
    VENDA_SABOR.ANO, 
    VENDA_SABOR.QUANTIDADE_TOTAL,
    ROUND((VENDA_SABOR.QUANTIDADE_TOTAL / VENDA_TOTAL.QUANTIDADE_GERAL) * 100, 2) AS PERCENTUAL
FROM (
    /* SOMA DE VENDAS POR SABOR NO ANO DE 2016 */
    SELECT 
        TP.SABOR, 
        YEAR(NF.DATA_VENDA) AS ANO, 
        SUM(INF.QUANTIDADE) AS QUANTIDADE_TOTAL
    FROM tabela_de_produtos TP
    INNER JOIN itens_notas_fiscais INF ON TP.CODIGO_DO_PRODUTO = INF.CODIGO_DO_PRODUTO
    INNER JOIN notas_fiscais NF ON NF.NUMERO = INF.NUMERO
    WHERE YEAR(NF.DATA_VENDA) = 2016
    GROUP BY TP.SABOR, YEAR(NF.DATA_VENDA)
) AS VENDA_SABOR
CROSS JOIN (
    /* SOMA TOTAL VENDIDA NO ANO (PARA O CÁLCULO DO %) */
    SELECT 
        SUM(INF.QUANTIDADE) AS QUANTIDADE_GERAL 
    FROM itens_notas_fiscais INF
    INNER JOIN notas_fiscais NF ON NF.NUMERO = INF.NUMERO
    WHERE YEAR(NF.DATA_VENDA) = 2016
) AS VENDA_TOTAL
ORDER BY VENDA_SABOR.QUANTIDADE_TOTAL DESC;
